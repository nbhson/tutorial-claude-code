{ "mcpServers": {
  "github": { "command": "npx", "args": ["@anthropic/mcp-github@latest"] },
  "playwright": { "command": "npx", "args": ["@playwright/mcp@latest"] },
  "internal-api": { "type": "http", "url": "${INTERNAL_API_URL}/mcp",
    "headers": { "Authorization": "Bearer ${INTERNAL_API_TOKEN}" } } } }
